{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "myzephyr/daemon-cross-build-manifest/2",
  "title": "myzephyr cross-built zephyrd: Linux AArch64, macOS x86_64, macOS arm64, Windows x86_64",
  "description": "Written by make-cross-manifest.py, checked by verify-cross-artifact.py. The binary cannot run on the build machine: the version is checked as an embedded string and by the native runtime job, never by executing it here.",
  "type": "object",
  "required": [
    "schema",
    "artifact",
    "source",
    "base",
    "own_commit_signer_primary_fingerprint",
    "workflow",
    "builder",
    "build",
    "static_report",
    "embedded",
    "checks"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "myzephyr/daemon-cross-build-manifest/2"
    },
    "artifact": {
      "type": "object",
      "required": [
        "name",
        "size",
        "sha256",
        "expected_version",
        "target",
        "format"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "expected_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-[0-9a-f]{9}$"
        },
        "target": {
          "$ref": "#/$defs/cross_target"
        },
        "format": {
          "enum": [
            "elf",
            "macho",
            "pe"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "target": {
              "const": "aarch64-linux-gnu"
            },
            "format": {
              "const": "elf"
            },
            "name": {
              "const": "zephyrd"
            }
          }
        },
        {
          "properties": {
            "target": {
              "const": "x86_64-apple-darwin"
            },
            "format": {
              "const": "macho"
            },
            "name": {
              "const": "zephyrd"
            }
          }
        },
        {
          "properties": {
            "target": {
              "const": "aarch64-apple-darwin"
            },
            "format": {
              "const": "macho"
            },
            "name": {
              "const": "zephyrd"
            }
          }
        },
        {
          "properties": {
            "target": {
              "const": "x86_64-w64-mingw32"
            },
            "format": {
              "const": "pe"
            },
            "name": {
              "const": "zephyrd.exe"
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "commit",
        "commit_time",
        "tags_at_head",
        "tags_in_checkout",
        "fetch_mode",
        "own_commits",
        "submodules"
      ],
      "additionalProperties": false,
      "properties": {
        "commit": {
          "$ref": "#/$defs/sha1"
        },
        "commit_time": {
          "type": "integer"
        },
        "tags_at_head": {
          "const": "none"
        },
        "tags_in_checkout": {
          "const": 0
        },
        "fetch_mode": {
          "enum": [
            "depth-1-no-tags+unshallow-no-tags",
            "local"
          ]
        },
        "own_commits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "commit",
              "paths"
            ],
            "additionalProperties": false,
            "properties": {
              "commit": {
                "$ref": "#/$defs/sha1"
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "submodules": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/sha1"
          }
        }
      }
    },
    "base": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "tag_object",
        "commit",
        "signer_primary_fingerprint",
        "signing_key"
      ],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "tag_object": {
          "$ref": "#/$defs/sha1"
        },
        "commit": {
          "$ref": "#/$defs/sha1"
        },
        "signer_primary_fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "signing_key": {
          "$ref": "#/$defs/fingerprint"
        }
      }
    },
    "own_commit_signer_primary_fingerprint": {
      "$ref": "#/$defs/fingerprint"
    },
    "workflow": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "repository",
            "ref",
            "sha",
            "workflow_ref",
            "workflow_sha",
            "event_name",
            "run_id",
            "run_number",
            "run_attempt",
            "job",
            "server_url",
            "pull_request"
          ],
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "ref": {
              "type": "string",
              "pattern": "^refs/(heads/ci/daemon-release-baseline|heads/my/[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*|pull/[0-9]+/merge)$"
            },
            "sha": {
              "$ref": "#/$defs/sha1"
            },
            "workflow_ref": {
              "type": "string",
              "minLength": 1
            },
            "workflow_sha": {
              "$ref": "#/$defs/sha1"
            },
            "event_name": {
              "enum": [
                "push",
                "pull_request"
              ]
            },
            "run_id": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "run_number": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "run_attempt": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "job": {
              "type": "string",
              "minLength": 1
            },
            "server_url": {
              "type": "string"
            },
            "pull_request": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/pull_request"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "local_build"
          ],
          "additionalProperties": false,
          "properties": {
            "local_build": {
              "const": true
            }
          }
        }
      ]
    },
    "builder": {
      "type": "object",
      "required": [
        "base_image",
        "apt_snapshot",
        "apt_state",
        "image_id",
        "toolchain",
        "package_inventory_sha256",
        "package_count",
        "source_date_epoch",
        "target"
      ],
      "additionalProperties": false,
      "properties": {
        "base_image": {
          "type": "string",
          "pattern": "@sha256:[0-9a-f]{64}$"
        },
        "apt_snapshot": {
          "type": "string",
          "pattern": "^[0-9]{8}T[0-9]{6}Z$"
        },
        "apt_state": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "image_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "toolchain": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "package_inventory_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "package_count": {
          "type": "integer",
          "minimum": 1
        },
        "source_date_epoch": {
          "type": "integer"
        },
        "target": {
          "$ref": "#/$defs/cross_target"
        }
      }
    },
    "build": {
      "type": "object",
      "required": [
        "recipe",
        "steps",
        "cmake_options",
        "cmake_target",
        "cpu_flags",
        "link_inventory_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "recipe": {
          "type": "object",
          "required": [
            "files",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "files": {
              "type": "object",
              "required": [
                "Dockerfile",
                "run-builder.sh",
                "build-in-container.sh"
              ],
              "additionalProperties": {
                "$ref": "#/$defs/sha256"
              }
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cmake_options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cmake_target": {
          "const": "daemon"
        },
        "cpu_flags": {
          "type": "object"
        },
        "link_inventory_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        }
      }
    },
    "static_report": {
      "type": "object",
      "required": [
        "format",
        "values",
        "checks"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "enum": [
            "elf",
            "macho",
            "pe"
          ]
        },
        "values": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        },
        "checks": {
          "const": "passed"
        }
      }
    },
    "embedded": {
      "type": "object",
      "required": [
        "versions",
        "seeds",
        "checks"
      ],
      "additionalProperties": false,
      "properties": {
        "versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string"
          }
        },
        "seeds": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "string"
          }
        },
        "checks": {
          "const": "passed"
        }
      }
    },
    "checks": {
      "type": "object",
      "required": [
        "expected_version_matches_source_state",
        "embedded_version_matches_expected",
        "binary_matches_static_report",
        "binary_matches_embedded_report",
        "workflow_identity_allowed"
      ],
      "additionalProperties": false,
      "properties": {
        "expected_version_matches_source_state": {
          "const": true
        },
        "embedded_version_matches_expected": {
          "const": true
        },
        "binary_matches_static_report": {
          "const": true
        },
        "binary_matches_embedded_report": {
          "const": true
        },
        "workflow_identity_allowed": {
          "enum": [
            true,
            "not-applicable"
          ]
        }
      }
    }
  },
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9A-F]{40}$"
    },
    "cross_target": {
      "enum": [
        "aarch64-linux-gnu",
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "x86_64-w64-mingw32"
      ]
    },
    "pull_request": {
      "type": "object",
      "required": [
        "number",
        "base_ref",
        "base_sha",
        "head_sha",
        "head_ref",
        "head_repository"
      ],
      "additionalProperties": false,
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "base_ref": {
          "type": "string",
          "pattern": "^my/[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
        },
        "base_sha": {
          "$ref": "#/$defs/sha1"
        },
        "head_sha": {
          "$ref": "#/$defs/sha1"
        },
        "head_ref": {
          "type": "string",
          "minLength": 1
        },
        "head_repository": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "workflow": {
            "required": [
              "local_build"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "checks": {
            "properties": {
              "workflow_identity_allowed": {
                "const": "not-applicable"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "checks": {
            "properties": {
              "workflow_identity_allowed": {
                "const": true
              }
            }
          },
          "source": {
            "properties": {
              "fetch_mode": {
                "const": "depth-1-no-tags+unshallow-no-tags"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workflow": {
            "properties": {
              "event_name": {
                "const": "pull_request"
              }
            },
            "required": [
              "event_name"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "workflow": {
            "properties": {
              "ref": {
                "pattern": "^refs/pull/[0-9]+/merge$"
              },
              "pull_request": {
                "type": "object"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "workflow": {
            "properties": {
              "ref": {
                "pattern": "^refs/heads/"
              },
              "pull_request": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ]
}
