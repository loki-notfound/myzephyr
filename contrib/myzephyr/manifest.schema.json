{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "myzephyr/daemon-build-manifest/2",
  "title": "myzephyr daemon build manifest",
  "description": "source is the compiled commit and the tags at it; base is the signed zephyr-backports tag it descends from; workflow is the run that built it.",
  "type": "object",
  "required": ["schema", "artifact", "source", "base", "own_commit_signer_primary_fingerprint", "workflow", "builder", "build", "runtime_requirements", "checks"],
  "additionalProperties": false,
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fingerprint": {"type": "string", "pattern": "^[0-9A-F]{40}$"}
  },
  "properties": {
    "schema": {"const": "myzephyr/daemon-build-manifest/2"},
    "artifact": {
      "type": "object",
      "required": ["name", "size", "sha256", "version_output", "expected_version", "target"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "version_output": {"type": "string"},
        "expected_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-(release|[0-9a-f]{9})$"},
        "target": {"type": "string"}
      }
    },
    "source": {
      "type": "object",
      "required": ["commit", "commit_time", "tags", "own_commits", "submodules"],
      "additionalProperties": false,
      "properties": {
        "commit": {"$ref": "#/$defs/sha1"},
        "commit_time": {"type": "integer"},
        "tags": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "object", "signer_primary_fingerprint"],
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "object": {"$ref": "#/$defs/sha1"},
              "signer_primary_fingerprint": {"$ref": "#/$defs/fingerprint"}
            }
          }
        },
        "own_commits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["commit", "paths"],
            "additionalProperties": false,
            "properties": {
              "commit": {"$ref": "#/$defs/sha1"},
              "paths": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            }
          }
        },
        "submodules": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha1"}}
      }
    },
    "base": {
      "type": "object",
      "required": ["repository", "tag", "tag_object", "commit", "signer_primary_fingerprint", "signing_key"],
      "additionalProperties": false,
      "properties": {
        "repository": {"type": ["string", "null"]},
        "tag": {"type": "string", "minLength": 1},
        "tag_object": {"$ref": "#/$defs/sha1"},
        "commit": {"$ref": "#/$defs/sha1"},
        "signer_primary_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "signing_key": {"$ref": "#/$defs/fingerprint"}
      }
    },
    "own_commit_signer_primary_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "workflow": {
      "oneOf": [
        {
          "type": "object",
          "required": ["repository", "ref", "sha", "workflow_ref", "workflow_sha", "event_name", "run_id", "run_number", "run_attempt", "job", "server_url"],
          "additionalProperties": false,
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "ref": {"type": "string", "pattern": "^refs/heads/"},
            "sha": {"$ref": "#/$defs/sha1"},
            "workflow_ref": {"type": "string", "minLength": 1},
            "workflow_sha": {"$ref": "#/$defs/sha1"},
            "event_name": {"const": "push"},
            "run_id": {"type": "string", "pattern": "^[0-9]+$"},
            "run_number": {"type": "string", "pattern": "^[0-9]+$"},
            "run_attempt": {"type": "string", "pattern": "^[0-9]+$"},
            "job": {"type": "string", "minLength": 1},
            "server_url": {"type": "string"}
          }
        },
        {
          "type": "object",
          "required": ["local_build"],
          "additionalProperties": false,
          "properties": {"local_build": {"const": true}}
        }
      ]
    },
    "builder": {
      "type": "object",
      "required": ["base_image", "apt_snapshot", "apt_state", "image_id", "toolchain", "package_inventory_sha256", "package_count", "source_date_epoch"],
      "additionalProperties": false,
      "properties": {
        "base_image": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"},
        "apt_snapshot": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z$"},
        "apt_state": {"type": "array", "items": {"type": "string"}},
        "image_id": {"type": ["string", "null"]},
        "toolchain": {"type": "array", "items": {"type": "string"}},
        "package_inventory_sha256": {"$ref": "#/$defs/sha256"},
        "package_count": {"type": "integer", "minimum": 1},
        "source_date_epoch": {"type": "integer"}
      }
    },
    "build": {
      "type": "object",
      "required": ["recipe", "steps", "cmake_options", "cmake_target", "cpu_flags"],
      "additionalProperties": false,
      "properties": {
        "recipe": {
          "type": "object",
          "required": ["files", "sha256"],
          "additionalProperties": false,
          "properties": {
            "files": {
              "type": "object",
              "required": ["Dockerfile", "run-builder.sh", "build-in-container.sh"],
              "additionalProperties": {"$ref": "#/$defs/sha256"}
            },
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "steps": {"type": "array", "items": {"type": "string"}},
        "cmake_options": {"type": "array", "items": {"type": "string"}},
        "cmake_target": {"const": "daemon"},
        "cpu_flags": {"type": "object"}
      }
    },
    "runtime_requirements": {
      "type": "object",
      "required": ["interpreter", "needed", "rpath_runpath", "max_glibc", "max_glibc_allowed", "cxx_version_needs", "symbols_above_glibc_2_17", "elf_checks", "build_id"],
      "additionalProperties": false,
      "properties": {
        "interpreter": {"type": ["string", "null"]},
        "needed": {"type": "array", "items": {"type": "string"}},
        "rpath_runpath": {"type": ["string", "null"]},
        "max_glibc": {"type": ["string", "null"]},
        "max_glibc_allowed": {"type": ["string", "null"]},
        "cxx_version_needs": {"type": ["string", "null"]},
        "symbols_above_glibc_2_17": {"type": "array", "items": {"type": "string"}},
        "elf_checks": {"enum": ["passed", "failed", null]},
        "build_id": {"type": ["string", "null"]}
      }
    },
    "checks": {
      "type": "object",
      "required": ["expected_version_matches_source_state", "version_output_matches_expected", "binary_matches_elf_report", "workflow_sha_is_source_commit"],
      "additionalProperties": false,
      "properties": {
        "expected_version_matches_source_state": {"const": true},
        "version_output_matches_expected": {"const": true},
        "binary_matches_elf_report": {"const": true},
        "workflow_sha_is_source_commit": {"enum": [true, "not-applicable"]}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"source": {"properties": {"tags": {"maxItems": 0}}}}},
      "then": {"properties": {"artifact": {"properties": {"expected_version": {"pattern": "-[0-9a-f]{9}$"}}}}},
      "else": {"properties": {"artifact": {"properties": {"expected_version": {"pattern": "-release$"}}}}}
    },
    {
      "if": {"properties": {"workflow": {"required": ["local_build"]}}},
      "then": {"properties": {"checks": {"properties": {"workflow_sha_is_source_commit": {"const": "not-applicable"}}}}},
      "else": {"properties": {"checks": {"properties": {"workflow_sha_is_source_commit": {"const": true}}}}}
    }
  ]
}
